<div class="list-groups">
  {% assign certificates = data[1] | sort: 'date' | reverse %}
  {% for content in certificates %}
    <div class="list-group col-md-6">
      <div class="certificate-item">
        <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
          {% if content.icon %}
            <div style="color: var(--global-accent); font-size: 1.1rem; margin-top: 0.1rem;">
              <i class="{{ content.icon }}"></i>
            </div>
          {% endif %}
          <div style="flex: 1;">
            <a href="{{ content.url | default: '#' }}" style="font-weight: 600; color: var(--global-text-color); text-decoration: none; font-size: 0.9rem;">
              {{ content.name }}
            </a>
            <div style="font-size: 0.82rem; color: var(--global-text-color-light); margin-top: 0.15rem;">
              {{ content.issuer }}
            </div>
            <div style="font-size: 0.75rem; color: var(--global-text-color-light); font-family: var(--global-font-mono); margin-top: 0.25rem;">
              {{ content.date }}
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
