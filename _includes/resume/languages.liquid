<div class="list-groups languages-list">
  {% for content in data[1] %}
    <div class="list-group col-md-6">
      <div class="language-item">
        {% if content.icon %}
          <i class="{{ content.icon }}" style="color: var(--global-accent);"></i>
        {% endif %}
        <span class="language-name">{{ content.language }}</span>
        <span class="language-fluency">{{ content.fluency }}</span>
      </div>
    </div>
  {% endfor %}
</div>
